# --- Прод / локалка: скопировать в .env и заполнить ---------------------------
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://tur_tuk:tur_tuk@localhost:5432/turtuk

# Публичный адрес API — из него строятся ссылки на фото для приложений.
PUBLIC_BASE_URL=
# Откуда разрешены запросы браузера (web-сборки): через запятую, * — все.
CORS_ORIGINS=*

# Фото: без S3 лежат в MEDIA_DIR и раздаются по /media. С S3 — в бакете.
MEDIA_DIR=media
S3_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# JWT. В production обязателен случайный секрет от 32 символов —
# с пустым/дефолтным сервер не стартует. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS: sms_ru | twilio. Лимиты защищают баланс от накрутки отправок.
SMS_PROVIDER=sms_ru
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_MAX_ATTEMPTS=5
SMS_RESEND_SECONDS=60
SMS_MAX_PER_PHONE_HOUR=5
SMS_MAX_PER_IP_HOUR=20
SMS_RU_API_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Вход в админку без пароля — только для тестов. В production запрещён.
ADMIN_TEST_LOGIN=0

# ЮKassa: shop_id и секретный ключ из личного кабинета.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=turtuk://payment/return

# Push (FCM HTTP v1): путь к JSON-ключу сервисного аккаунта Firebase
# (Project settings → Service accounts → Generate new private key)
# или сам JSON одной строкой.
NOTIFICATION_PROVIDER=fcm
FCM_SERVICE_ACCOUNT=
