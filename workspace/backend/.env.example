DATABASE_URL=postgresql+asyncpg://tur_tuk:tur_tuk@localhost:5433/tur_tuk

# S3-compatible storage — provider not chosen yet, fill in when it is.
S3_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# JWT — сменить в проде, дефолт в коде только для локальной разработки.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS-провайдер: sms_ru | twilio — выбор владельца ещё не сделан.
SMS_PROVIDER=sms_ru
SMS_CODE_LENGTH=4
SMS_CODE_TTL_MINUTES=5
SMS_RU_API_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Люк для приёмочных проверок веб-админки: POST /admin/test-login выдаёт
# cookie-JWT тестовому owner'у без SMS-подтверждения. НЕ включать в
# production — обычный SMS-логин персонала этим не подменяется, а обходится.
ADMIN_TEST_LOGIN=0

# ЮKassa (стек, curated: «Платежи: ЮKassa (СБП + карты РФ)») — владелец
# магазина в ЮKassa ещё не создан, значения пустые.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Deep link мобильного приложения — куда ЮKassa редиректит после оплаты.
YOOKASSA_RETURN_URL=turtuk://payment/return

# Push-уведомления: провайдер из открытого вопроса брифа (FCM/RuStore Push)
# не выбран окончательно — по умолчанию FCM (стек), доступ к консоли Firebase
# у владельца пока под вопросом, значение пустое.
NOTIFICATION_PROVIDER=fcm
FCM_SERVER_KEY=
