# Домен API и админки (A-запись → IP сервера). Админка: https://DOMAIN/admin
DOMAIN=api.example.com
# Почта для уведомлений Let's Encrypt
ACME_EMAIL=

# Пароль PostgreSQL (любой длинный случайный)
DB_PASSWORD=

# Обязателен: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Откуда разрешены запросы браузера (web-демо). Для мобильных приложений не нужен.
CORS_ORIGINS=*

# SMS (sms_ru | twilio)
SMS_PROVIDER=sms_ru
SMS_RU_API_ID=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=turtuk://payment/return

# Push: положить JSON-ключ Firebase в deploy/prod/secrets/firebase.json
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json

# Фото в S3 (необязательно — без этого фото хранятся в volume media на сервере)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
